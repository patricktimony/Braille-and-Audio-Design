# SimpleGit settings. You normally do NOT need to edit this file:
# the setup page fills in the GitHub settings for you and saves them in .env.
# Copy this file to .env only if you want to set things by hand.

# The address people use to open SimpleGit. Leave empty when running on your
# own computer (it is then http://localhost:3000 and only this computer can use it).
# BASE_URL=https://simplegit.example.org

# PORT=3000

# Filled in automatically by the setup page:
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_APP_SLUG=

# Encrypts the sign-in cookie. Created automatically if missing (32+ characters).
# SESSION_SECRET=

# Set to 1 only while doing setup from another computer (for a server copy).
# ALLOW_REMOTE_SETUP=1

# Only if you use a classic OAuth App instead of a GitHub App (not recommended):
# GITHUB_OAUTH_SCOPES=repo workflow read:user
