<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hardware-independent logic: page model, navigation, reading controller,
    saving, settings, text-quality and blank-page checks.
    No NuGet packages. No Windows-only APIs, so it can be unit-tested anywhere.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ScanReader.Core</RootNamespace>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
