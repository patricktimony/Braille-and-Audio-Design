<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Self-contained test runner: no test framework packages, so the tests need
    nothing beyond the .NET SDK and can be read top to bottom.
    Run:  dotnet run (from the tests/ScanReader.Tests folder)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ScanReader.Core\ScanReader.Core.csproj" />
  </ItemGroup>

</Project>
