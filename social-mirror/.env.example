# Copy this file to .env and fill in the keys you have.
# Keys stay on the server; the browser never sees them.

# Required for real YouTube comments.
# Google Cloud Console -> APIs & Services -> enable "YouTube Data API v3" -> Credentials -> API key
YOUTUBE_API_KEY=

# Required for the AI extraction of descriptive words (the word cloud).
# https://console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# Optional: Reddit comments via Reddit's official OAuth API (app-only).
# https://www.reddit.com/prefs/apps -> "create another app" -> type "script"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=social-mirror/0.1 (by u/your_reddit_username)

# Optional tuning
# ANTHROPIC_MODEL=claude-opus-5-5
# YOUTUBE_MAX_PAGES=5        # 100 comment threads per page
# REDDIT_MAX_THREADS=5
# CACHE_HOURS=24
# PORT=3001
