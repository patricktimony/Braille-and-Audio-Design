{
  "name": "social-mirror",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:server\" \"npm:web\"",
    "server": "node --watch-path=server server/index.js",
    "web": "vite",
    "build": "vite build",
    "start": "vite build && NODE_ENV=production node server/index.js",
    "test": "node --test server/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@vitejs/plugin-react": "^4.7.0",
    "dotenv": "^18.0.6",
    "express": "^4.22.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.21"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
